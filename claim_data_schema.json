{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CMS-1500 Health Insurance Claim Form Data Schema",
  "description": "Simplified schema for extracted CMS-1500 form data using Ollama OCR",
  "type": "object",
  "required": [
    "form_info",
    "patient_info",
    "diagnosis",
    "service_lines",
    "billing_info"
  ],
  "properties": {
    "form_info": {
      "type": "object",
      "properties": {
        "carrier": {
          "type": "string"
        },
        "form_type": {
          "type": "string"
        },
        "form_number": {
          "type": "string"
        }
      },
      "required": ["form_type"]
    },
    "patient_info": {
      "type": "object",
      "properties": {
        "name": {
          "type": "object",
          "properties": {
            "last_name": {"type": "string"},
            "first_name": {"type": "string"},
            "middle_initial": {"type": "string"},
            "full_name": {"type": "string"}
          },
          "required": ["full_name"]
        },
        "date_of_birth": {
          "type": "object",
          "properties": {
            "formatted": {"type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$"},
            "month": {"type": "string"},
            "day": {"type": "string"},
            "year": {"type": "string"}
          },
          "required": ["formatted"]
        },
        "sex": {
          "type": "object",
          "properties": {
            "value": {"type": "string", "enum": ["M", "F", ""]}
          }
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {"type": "string"},
            "city": {"type": "string"},
            "state": {"type": "string", "pattern": "^[A-Z]{2}$"},
            "zip_code": {"type": "string", "pattern": "^\\d{5}(-\\d{4})?$"}
          }
        },
        "telephone": {
          "type": "object",
          "properties": {
            "formatted": {"type": "string"}
          }
        },
        "relationship_to_insured": {
          "type": "object",
          "properties": {
            "value": {"type": "string", "enum": ["Self", "Spouse", "Child", "Other", ""]},
            "options": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "id_number": {
          "type": "object",
          "properties": {
            "value": {"type": "string"},
            "type": {"type": "string"}
          },
          "required": ["value"]
        },
        "policy_group_number": {
          "type": "object",
          "properties": {
            "value": {"type": "string"}
          }
        }
      },
      "required": ["name", "date_of_birth", "id_number"]
    },
    "diagnosis": {
      "type": "object",
      "properties": {
        "icd_indicator": {
          "type": "object",
          "properties": {
            "value": {"type": "string", "enum": ["0", "1", ""]},
            "description": {"type": "string"}
          },
          "required": ["value"]
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^[A-L]$"
              },
              "code": {
                "type": "string"
              },
              "description": {"type": "string"}
            },
            "required": ["pointer", "code"]
          },
          "minItems": 1
        }
      },
      "required": ["icd_indicator", "codes"]
    },
    "service_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_number": {
            "type": "integer",
            "minimum": 1
          },
          "dates_of_service": {
            "type": "object",
            "properties": {
              "from": {
                "type": "object",
                "properties": {
                  "formatted": {"type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$"},
                  "month": {"type": "string"},
                  "day": {"type": "string"},
                  "year": {"type": "string"}
                },
                "required": ["formatted"]
              },
              "to": {
                "type": "object",
                "properties": {
                  "formatted": {"type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$"},
                  "month": {"type": "string"},
                  "day": {"type": "string"},
                  "year": {"type": "string"}
                },
                "required": ["formatted"]
              }
            },
            "required": ["from", "to"]
          },
          "place_of_service": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "description": {"type": "string"}
            },
            "required": ["code"]
          },
          "procedure_code": {
            "type": "object",
            "properties": {
              "code": {"type": "string"},
              "modifier": {"type": "string"},
              "description": {"type": "string"}
            },
            "required": ["code"]
          },
          "diagnosis_pointer": {
            "type": "object",
            "properties": {
              "value": {"type": "string"},
              "pointers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-L]$"
                }
              }
            },
            "required": ["value"]
          },
          "charges": {
            "type": "object",
            "properties": {
              "formatted": {"type": "string"},
              "amount": {"type": "number"},
              "currency": {"type": "string", "default": "USD"}
            },
            "required": ["formatted", "amount"]
          },
          "days_units": {
            "type": "object",
            "properties": {
              "value": {"type": "string"},
              "type": {"type": "string"},
              "description": {"type": "string"}
            },
            "required": ["value"]
          },
          "amount_paid": {
            "type": "object",
            "properties": {
              "formatted": {"type": "string"},
              "amount": {"type": "number"},
              "currency": {"type": "string", "default": "USD"}
            }
          },
          "rendering_provider": {
            "type": "object",
            "properties": {
              "npi": {
                "type": "object",
                "properties": {
                  "value": {"type": "string", "pattern": "^\\d{10}$"}
                },
                "required": ["value"]
              },
              "id": {
                "type": "object",
                "properties": {
                  "value": {"type": "string"},
                  "qualifier": {"type": "string"}
                }
              }
            }
          }
        },
        "required": [
          "dates_of_service",
          "place_of_service",
          "procedure_code",
          "diagnosis_pointer",
          "charges",
          "days_units"
        ]
      },
      "minItems": 1
    },
    "billing_info": {
      "type": "object",
      "properties": {
        "patient_account_number": {
          "type": "object",
          "properties": {
            "value": {"type": "string"}
          },
          "required": ["value"]
        },
        "total_charge": {
          "type": "object",
          "properties": {
            "formatted": {"type": "string"},
            "amount": {"type": "number"},
            "currency": {"type": "string", "default": "USD"}
          }
        },
        "amount_paid": {
          "type": "object",
          "properties": {
            "formatted": {"type": "string"},
            "amount": {"type": "number"},
            "currency": {"type": "string", "default": "USD"}
          }
        },
        "balance_due": {
          "type": "object",
          "properties": {
            "formatted": {"type": "string"},
            "amount": {"type": "number"},
            "currency": {"type": "string", "default": "USD"}
          }
        }
      },
      "required": ["patient_account_number"]
    }
  }
}
